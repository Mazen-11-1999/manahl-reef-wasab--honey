# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority&appName=cluster-name

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-128-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-change-this-128-chars
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# Application Configuration
FRONTEND_URL=https://your-domain.vercel.app
CLOUD_STORAGE_ENABLED=true
DISABLE_CACHE=false
FORCE_REBUILD=false

# Admin Configuration
ADMIN_PASSWORD=your-admin-password-min-6-chars

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
